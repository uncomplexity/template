{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"headers": {
				"Authorization": "Bearer {env:EXA_API_KEY}"
			},
			"enabled": true
		},
		"patchright": {
			"type": "local",
			"command": ["npx", "patchright-mcp@latest"],
			"enabled": false
		}
	},
	"permission": {
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.tfvars": "deny",
			"*example.tfvars": "allow",
			"*backend.conf": "deny"
		}
	}
}
